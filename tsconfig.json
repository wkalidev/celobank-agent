{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "lib": ["es2023", "dom"],
    "module": "node16",
    "target": "es2022",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node16",
    "outDir": "dist",
    "jsx": "react-jsx"
  },
  "exclude": ["scripts/**/*", "node_modules", "dist", "packages/**"]
}