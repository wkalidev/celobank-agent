PRIVATE_KEY=0x_YOUR_PRIVATE_KEY
CELO_RPC=https://forno.celo.org
ANTHROPIC_API_KEY=sk-ant-YOUR_ANTHROPIC_KEY
GROQ_API_KEY=gsk_YOUR_GROQ_KEY
CONTRACT_ADDRESS=0x4ebef67f7a20485ccc9e66ee58fcc99f23e93de1
THIRDWEB_SECRET_KEY=your_thirdweb_secret_key
TOKEN_FACTORY_ADDRESS=0x597f121c014b99a15c7c4e08928f0fe1ec3adc2e
# WalletConnect Cloud project ID — get one free at https://cloud.walletconnect.com
# Vite requires VITE_ prefix to expose env vars to the browser bundle
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
# Self Agent ID — set after completing passport verification via https://self.xyz
# See README.md § Self Agent ID for the full registration flow
SELF_AGENT_OWNER_ADDRESS=
SELF_AGENT_NETWORK=mainnet
# Set after linked-mode registration completes (output by npm run self-agent-fix)
SELF_AGENT_ADDRESS=
# Celo Builders attribution tag — credits this agent's on-chain tx volume to
# the "Agentic Payments & DeFAI Hackathon" leaderboard (celo_ + 12 hex).
# Get yours: npx skills add https://celobuilders.xyz, then register the
# project (projectName, githubUrl=https://github.com/wkalidev/celobank-agent,
# telegram=@snifertoken) for hackathon "agentic-payments-defai".
# See https://docs.celo.org/build-on-celo/attribution-tags
ATTRIBUTION_TAG=
# Optional: your own pre-existing attribution code, tagged alongside ATTRIBUTION_TAG
OWN_ATTRIBUTION_CODE=
# Vite requires the VITE_ prefix to expose a var to the browser bundle. These
# mirror ATTRIBUTION_TAG/OWN_ATTRIBUTION_CODE above and are only needed for the
# DailyDrop check-in/claim flows (src/ui/App.tsx), which build their own
# transaction calldata client-side and never pass through src/tools/prepare.ts —
# so they can't inherit the server-side tag automatically. Set the same values
# here as above.
VITE_ATTRIBUTION_TAG=
VITE_OWN_ATTRIBUTION_CODE=

# Celoscan contract verification (npx hardhat verify) — get a free API key at
# https://etherscan.io/apidashboard. Celoscan is served by the unified
# Etherscan V2 API, so one key works for Celo Mainnet (42220) and every other
# supported chain.
CELOSCAN_API_KEY=

# A Divvi referral-tag integration (third-party attribution covering Mento/
# Uniswap/Aave/StakedCelo calls) was evaluated here in July 2026 and removed —
# @divvi/referral-sdk was deprecated on npm and the divvi-xyz GitHub org
# archived, with app.divvi.xyz no longer resolving. See CHANGELOG.md before
# re-attempting this.